      <static>true</static>
      <pose>-15 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 30 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 30 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


  <!-- Position and rotation of the ramp -->
<!-- ========================================================= -->
<!-- ROUTE 1: DIRECT NORTH → SOUTH 3D RAMP                    -->
<!-- ========================================================= -->

<!-- POINT A / NORTH GROUND AREA -->
<model name="route1_point_A">
  <static>true</static>
  <pose>0 10 0.05 0 0 0</pose>

  <link name="link">
    <collision name="collision">
